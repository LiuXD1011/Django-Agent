+test('SEARCH-UI-05 explicit connection tests report zero results, disabled, missing config and failure without retries', async () => {
+  let response = { success: true, data: { state: 'connected', result_count: 0 } }, status = 200
+  const f = await fixture({ providers: [provider()], respond: request => request.path.endsWith('/test') ? { status, body: response } : undefined })
+  try {
+    const card = f.page.locator('[data-provider-id="search-a"]'), button = card.getByRole('button', { name: '测试连接', exact: true })
+    for (const [nextStatus, nextResponse, expected] of [
+      [200, response, '连接成功，本次返回 0 条结果'],
+      [200, { success: true, data: { state: 'disabled' } }, '服务已停用，未发出搜索请求'],
+      [200, { success: true, data: { state: 'not_configured' } }, '服务配置不完整，请检查地址和凭据'],
+      [502, { success: false, error: { code: 'integration_connection_failed', message: '受控连接失败' } }, '受控连接失败'],
+    ]) {
+      status = nextStatus; response = nextResponse
+      await button.click(); await card.getByText(expected, { exact: true }).waitFor()
+    }
+    assert.equal(f.state.requests.filter(request => request.path.endsWith('/test') && request.method === 'POST').length, 4)
+    assert.deepEqual(f.state.errors, [])
+  } finally { await f.close() }
+})
