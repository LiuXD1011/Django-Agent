  "read_findings": [
    "CoreDatabase constructor migrates and opens writable connection; cannot be Query constructor",
    "CoreDatabase.transaction uses immediate; Query needs real synchronous deferred transaction",
    "SearchIndex constructor performs DDL; only pure index.state is needed for first knowledge batch",
    "CredentialVault constructor writes nothing; decrypt reads existing key and cannot create it",
    "Settings/Models constructors create StartupConfiguration; reader must use owner frozen active mirror",
    "IPC auth regex currently uses raw path while app dispatch uses normalized pathname",
    "Private IPC session has access plus refresh and must remain owner-persisted; only private access mirror crosses to Query",
    "Auth recheck within old WAL snapshot requires an additional coordinator reply epoch fence",
    "Shared atomics and SQLite COMMIT are not one atomic operation; auth before/after-save races need real tests",
    "Tenant switch currently returns checked identity and does not mutate primary tenant/session"
  ],
  "red_plan": {
    "executed": false,
