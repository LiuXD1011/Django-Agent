+      router.push('/platform/knowledge-bases/removed').then(()=>router.isReady()).then(()=>app.mount('#app'));`, loader: 'ts', resolveDir: directory },
+    bundle: true, write: false, format: 'iife', outdir: '/virtual/kb-load-layout',
