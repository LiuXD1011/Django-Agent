# ── Django 安全配置 ──────────────────────────────────────────────────
# 生产环境必须设置以下变量
# DJANGO_SECRET_KEY=your-secret-key-here
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com
# CORS_ALLOWED_ORIGINS=https://yourdomain.com

# 开发环境默认值（生产环境请注释掉）
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── 应用配置 ────────────────────────────────────────────────────────
APP_NAME=个人轻量知识库

# ── LLM 对话模型 ────────────────────────────────────────────────────
# 支持任意 OpenAI 兼容接口（OpenAI、DeepSeek、Ollama、vLLM、阿里云百炼等）
LLM_CHAT_API_KEY=
LLM_CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_CHAT_MODEL=qwen3.7-plus
LLM_CHAT_MODEL_TIMEOUT=60
LLM_MODEL_NUM_RETRIES=2

# ── LLM 摘要/标题/问题生成/抽取模型（通常与对话模型相同）─────────────
LLM_SUMMARY_MODEL=qwen3.7-plus
LLM_TITLE_MODEL=qwen3.7-plus
LLM_QUESTION_MODEL=qwen3.7-plus
LLM_EXTRACT_MODEL=qwen3.7-plus

# ── Embedding 模型 ──────────────────────────────────────────────────
# 可以使用不同提供商的 Embedding 模型
LLM_EMBEDDING_API_KEY=
LLM_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_EMBEDDING_MODEL=text-embedding-v4
LLM_EMBEDDING_DIM=1024

# ── Rerank 模型 ─────────────────────────────────────────────────────
LLM_RERANK_API_KEY=
LLM_RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_RERANK_MODEL=qwen3-rerank

# ── VLM 视觉模型（可选）────────────────────────────────────────────
LLM_VLM_API_KEY=
LLM_VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_VLM_MODEL=qwen-vl-plus

# ── Neo4j 配置（知识图谱 + 记忆系统）────────────────────────────────
# 需要先启动 Neo4j：docker run -d --name neo4j -p 7474:7474 -p 7687:7687 -e NEO4J_AUTH=neo4j/password neo4j:5-community
NEO4J_ENABLE=true
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# ── Langfuse 可观测性（可选，默认关闭）───────────────────────────────
# 自托管：docker compose -f docker-compose.langfuse.yml up -d 后在本项目 UI 创建项目获取 key。
# 云端：注册 https://cloud.langfuse.com 获取 key。
# 必须显式设置 LANGFUSE_ENABLED=true 才启用（关闭时不出网）。
# LANGFUSE_ENABLED=false
# 后端 Langfuse API 地址（新首选；自托管默认 http://localhost:3000）
# LANGFUSE_BASE_URL=http://localhost:3000
# 旧别名，仅 BASE_URL 未设置时生效
# LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# 内容采集总开关（默认 false：不上传问题/回答/工具 query/文档正文；开启后仍做脱敏+截断）
# LANGFUSE_LOG_CONTENT=false
# 无业务 trace 上下文时 generation 的处理：skip（默认）/ standalone
# LANGFUSE_ORPHAN_MODE=skip
# 评估题目/参考答案上传为 Langfuse Dataset（默认 false，仅批准的合成数据验收时开启）
# LANGFUSE_UPLOAD_EVAL_DATASETS=false
# SDK environment 标签（区分 development/production）
# LANGFUSE_TRACING_ENVIRONMENT=development
# 根级采样率 0~1（默认 1.0；SDK 固定全量，避免二次采样）
# LANGFUSE_SAMPLE_RATE=1.0
# 浏览器可访问的 Langfuse UI 地址（默认同 BASE_URL；容器/宿主地址不一致时单独配置）
# LANGFUSE_UI_BASE_URL=http://localhost:3000
# Langfuse 项目 ID（追踪链接和设置页共用；兼容 LANGFUSE_PROJECT_ID，再回退初始化项目 ID）
# LANGFUSE_UI_PROJECT_ID=
# 会话轨迹"查看 Langfuse 追踪"跳转开关（默认 false；开启后仅平台运维角色可见链接）
# LANGFUSE_TRACE_LINKS_ENABLED=false

# ── 任务配置 ─────────────────────────────────────────────────────────
# 后台任务线程数（默认 4）
# APP_TASK_WORKERS=4

# ── SQLite 配置 ──────────────────────────────────────────────────────
# 数据库锁等待超时（秒，默认 30）
# SQLITE_TIMEOUT=30

# ── 日志级别 ─────────────────────────────────────────────────────────
# DJANGO_LOG_LEVEL=INFO

# Local Langfuse startup and browser login (loopback, authorized local account/admin)
LANGFUSE_AUTOSTART=true
LANGFUSE_STARTUP_TIMEOUT_SECONDS=45
LANGFUSE_AUTO_LOGIN=true
# 外部部署：将 AUTOSTART 和 AUTO_LOGIN 设为 false；设置页仍可手动打开 UI_BASE_URL。
# Optional overrides; otherwise read existing .env.langfuse INIT_USER credentials.
# LANGFUSE_LOGIN_EMAIL=
# LANGFUSE_LOGIN_PASSWORD=

# Optional exact local app user ID permitted to use the loopback Langfuse login bridge.
# Does not grant any system-administrator privileges.
# LANGFUSE_LOCAL_LOGIN_USER_ID=
